{
  "appId": "com.edusync.college.platform",
  "appName": "EduSync",
  "webDir": "src/main/resources/static",
  "server": {
    "cleartext": true,
    "androidScheme": "http",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "showSpinner": true,
      "spinnerColor": "#2563eb"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  }
}
